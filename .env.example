# Copia este archivo como .env y cambia los valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).
# Usa claves largas y unicas. Evita simbolos como @ : / # en la clave de la base
# de datos, porque van dentro de DATABASE_URL.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=mi_portafolio_db

PGADMIN_EMAIL=tu-correo@ejemplo.com
PGADMIN_PASSWORD=cambia-esta-clave

# Para correr sin Docker (npm run dev), usa la URL con tu propia clave:
# DATABASE_URL=postgresql://postgres:cambia-esta-clave@localhost:5432/mi_portafolio_db
